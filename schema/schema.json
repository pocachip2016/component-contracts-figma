{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nvillapiano/component-contracts-figma/schema/schema.json",
  "title": "Component Contract",
  "description": "Schema for a Component Contracts contract file.",
  "type": "object",
  "required": ["id", "version", "displayName", "tokens", "props", "states"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "description": "Unique component identifier. Used in CSS custom property names." },
    "version": { "type": "string", "description": "Semver version string." },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "stable", "deprecated"] },
    "platforms": {
      "type": "array",
      "items": { "type": "string", "enum": ["web", "ios", "android"] }
    },
    "tokens": {
      "type": "object",
      "description": "Tier 3 token bindings. Values are Semantic token paths.",
      "properties": {
        "color": { "type": "object" },
        "typography": { "type": "object" },
        "spacing": { "type": "object" },
        "border": { "type": "object" },
        "motion": { "type": "object" }
      }
    },
    "props": {
      "type": "object",
      "description": "Component props. Variant axes use type: enum.",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["enum", "string", "boolean", "function", "ref"] },
          "values": { "type": "array" },
          "default": {},
          "required": { "type": "boolean" },
          "tokenMapped": { "type": "boolean" },
          "description": { "type": "string" },
          "platforms": { "type": "object" }
        }
      }
    },
    "states": {
      "type": "array",
      "description": "State axis values. Drive the variant matrix.",
      "items": { "type": "string" }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "props"],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "description": { "type": "string" },
          "props": { "type": "object" }
        }
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "childOrder": { "type": "array", "items": { "type": "string" } },
              "children": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string" },
                    "description": { "type": "string" },
                    "figma": {
                      "type": "object",
                      "description": "Figma rendering hints.",
                      "properties": {
                        "textProp": { "type": "string" },
                        "booleanProp": { "type": "string" },
                        "visible": { "type": "boolean" },
                        "position": { "type": "string" },
                        "sizing": { "type": "string", "enum": ["fixed"] },
                        "width": { "type": "number" },
                        "height": { "type": "number" },
                        "rotateOnExpand": { "type": "boolean" },
                        "defaultRotation": { "type": "number" },
                        "expandedRotation": { "type": "number" },
                        "visibleWhen": { "type": "string" },
                        "defaultGlyph": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "forbiddenParents": { "type": "array", "items": { "type": "string" } }
      }
    },
    "behavior": { "type": "object" },
    "accessibility": { "type": "object" },
    "usage": { "type": "object" },
    "platformNotes": { "type": "object" },
    "changelog": { "type": "array" },
    "slots": {
      "type": "array",
      "description": "Pixel-bbox content-injection slots (batch rendering / Dam asset mapping). Distinct from composition.slots (Figma structural children) despite the shared name.",
      "items": {
        "type": "object",
        "required": ["id", "bbox"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string", "description": "Semantic role, e.g. title_overlay" },
          "kind": { "type": "string", "enum": ["image", "text"] },
          "bbox": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false,
            "description": "px, top-left origin of the base canvas",
            "properties": {
              "x": { "type": "number", "minimum": 0 },
              "y": { "type": "number", "minimum": 0 },
              "w": { "type": "number", "exclusiveMinimum": 0 },
              "h": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "bboxNormalized": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false,
            "description": "0-1 normalized (optional field, but all 4 values are required together when present)",
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "w": { "type": "number", "minimum": 0, "maximum": 1 },
              "h": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "fixedSize": { "type": "boolean", "description": "Excluded from responsive recalculation (Banner fixed-size exception precedent)" },
          "isRequired": { "type": "boolean", "description": "Slot payload field, not the JSON Schema `required` keyword — whether this slot is mandatory for rendering." }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "text": {
          "type": "object",
          "properties": {
            "maxLength": { "type": "integer", "minimum": 1 },
            "overflow": { "type": "string", "enum": ["shrink", "clamp", "reject"] }
          }
        },
        "safeArea": {
          "type": "array",
          "description": "Slot references subject to collision checks (e.g. logo-vs-face)",
          "items": {
            "type": "object",
            "properties": {
              "slotId": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "rendering": {
      "type": "object",
      "properties": {
        "baseCanvas": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "outputFormats": {
          "type": "array",
          "items": { "type": "string", "enum": ["png", "jpg", "webp"] }
        }
      }
    },
    "x-dam": {
      "type": "object",
      "description": "Dam-dependent field namespace, kept separate from core so the contract stays valid without Dam. Property name has a hyphen — consuming code must use bracket access (contract['x-dam']).",
      "properties": {
        "assetQuery": { "type": "object", "description": "Free-form — exact query shape finalized in Step 6/8" },
        "sourceCohort": { "type": "string" },
        "provenance": { "type": "object", "description": "Free-form, e.g. sha256/git commit/db_snapshot" }
      }
    }
  }
}
